# ============================================
# CONFIGURACIÓN PARA TURSO (libSQL)
# ============================================
# Copia este archivo a .env y ajusta los valores
# cp .env.example .env

# --------------------------------------------
# TURSO DATABASE
# --------------------------------------------
# Obtén estos valores en: https://app.turso.tech
# 1. Crea una base de datos
# 2. Ve a Settings > Database URL (formato: libsql://xxx-xxx.turso.io)
# 3. Genera un Auth Token: Settings > Auth Tokens > Generate Token

# Formato libsql:// (recomendado)
TURSO_DATABASE_URL=libsql://tu-db-tu-org.turso.io

# O formato HTTP directo
# TURSO_DATABASE_URL=https://tu-db-tu-org.turso.io

# Token de autenticación (requerido para escritura)
TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------
# LEGACY MYSQL (compatibilidad - no usar con Turso)
# --------------------------------------------
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=inventario_medicamentos
# DB_USER=root
# DB_PASS=root
# DB_SSL_CA=

# --------------------------------------------
# APLICACIÓN
# --------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
MAIL_FROM=no-reply@tu-dominio.com

# --------------------------------------------
# SESIÓN
# --------------------------------------------
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=lax