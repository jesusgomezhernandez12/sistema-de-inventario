# Vercel Environment Variables
# Configure these in Vercel Dashboard → Settings → Environment Variables

# Turso Database (required)
TURSO_DATABASE_URL=libsql://tu-db-tu-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret for auth tokens (generate with: openssl rand -base64 32)
JWT_SECRET=tu-jwt-secret-super-seguro-aqui

# App URL (your Vercel deployment URL)
APP_URL=https://tu-proyecto.vercel.app

# Optional: Email (for password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-app-password
# SMTP_SECURE=tls
# MAIL_FROM=noreply@tu-dominio.com