# Turso (libSQL) Configuration
# Get these from: https://app.turso.tech
# 1. Create database: turso db create inventario-ganadero
# 2. Get URL: turso db show inventario-ganadero --url
# 3. Get token: turso db tokens create inventario-ganadero

TURSO_DATABASE_URL=libsql://tu-db-tu-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000